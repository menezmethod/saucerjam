    "workdir": "/Users/luisgimenez/code/github.com/menezmethod/saucerjam",
    "model": "deepseek-v4.1-flash",
    "provider": "opencode-go",
    "timeout_s": 60,
    "required_env": ["COMMUNITY_ACTION_TOKEN"],
    "worker_endpoints": {
      "claim": "POST /api/community/claim",
      "complete": "POST /api/community/action",
