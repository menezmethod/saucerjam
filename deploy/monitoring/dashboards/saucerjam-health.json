    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "Which endpoint is slow? Once the top panel says *something* is slow, this panel says *what*.\nRoutes are templates (e.g. `/api/statistics`), never raw URLs. Raw URLs would let anyone create unlimited series (cardinality explosion).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
