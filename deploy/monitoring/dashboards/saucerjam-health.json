    {
      "type": "timeseries",
      "title": "Probe latency (outside-in)",
      "description": "How long Prometheus takes to fetch /metrics through Cloudflare.\nAlways has data, even with zero players, so it's the **low-traffic stand-in** for user latency. A jump here with no code change usually means the network or the Oracle VM.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "scrape_duration_seconds{job=\"saucerjam\"}",
          "legendFormat": "probe"
        }
      ],
      "options": {
