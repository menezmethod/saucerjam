    {
      "type": "timeseries",
      "title": "Session length p50 / p95",
      "description": "How long a play session lasts, from websocket connect to disconnect. p95 is the marathon session.\nSessions shorter than a round suggest people bounce; watch this after onboarding changes. *Needs deploy.*",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "needs deploy"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(saucerjam_session_seconds_bucket[30m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(saucerjam_session_seconds_bucket[30m])))",
          "legendFormat": "p95"
        }
