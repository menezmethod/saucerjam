    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 89,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "SaucerJam runs entirely on the **Oracle Always Free** shape (2 ARM cores, 12 GB RAM, 200 GB disk): **$0/month**. There is no billing metric to graph, so the number that matters is **headroom** below.\nIf utilisation approaches the free shape, the decision is *scale up or move* \u2014 and that belongs on this board, because it is a business call, not an incident. Sources: [Google Cloud SRE blog](https://cloud.google.com/blog/products/devops-sre)."
      }
    },
    {
      "type": "gauge",
      "title": "Host CPU busy",
      "description": "Share of the 2 free ARM cores in use (5-min average). The game simulates every match server-side, so CPU tracks active matches, not page views.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 93,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"oci-node\",mode=\"idle\"}[5m]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Host memory used",
      "description": "The whole free VM (12 GB), shared with the game, Supabase, Fider and monitoring.\nThe database is the largest tenant \u2014 see Platform & dependencies.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 6,
        "y": 93,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "1 - node_memory_MemAvailable_bytes{job=\"oci-node\"} / node_memory_MemTotal_bytes{job=\"oci-node\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Disk used (of 200 GB)",
      "description": "Block-storage headroom on the free tier. Supabase, container images and the Prometheus 30-day TSDB all live here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 93,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
