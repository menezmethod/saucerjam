          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "1 - node_filesystem_avail_bytes{job=\"oci-node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"oci-node\",mountpoint=\"/\"}",
          "legendFormat": ""
        }
      ]
    },
