{
  "name": "saucerjam",
  "version": "1.4.0",
  "private": true,
  "description": "Neon arena combat with a shared authoritative multiplayer simulation",
  "scripts": {
    "start": "npm run build && node server/server.js",
    "serve": "node server/server.js",
    "dev": "node scripts/dev.js",
    "build": "webpack --mode production",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js shared/maps/*.test.cjs src/view/*.test.cjs server/rankings/*.test.js src/interface/*.test.cjs src/world/*.test.mjs src/input/*.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "capture": "node scripts/verification/capture.cjs",
    "release:pack": "node scripts/package-release.cjs",
    "ops:selftest": "node scripts/ops/selftest.cjs",
    "ops:smoke": "node scripts/ops/smoke-e2e.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
