# Optional environment variables. Export them in your shell or hosting provider.
# npm start serves the game and multiplayer together on this port.
PORT=8080
# Public Supabase project settings used by the browser and server-side session verification.
# Never put the Supabase service_role key here or in browser code.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_AUTH_PROVIDERS=google
# Server-only Fider bridge settings. Never expose FIDER_API_KEY to the browser.
# FIDER_BASE_URL=https://community.menezmethod.com
# FIDER_API_KEY=replace-with-a-dedicated-fider-service-account-key
# APP_VERSION=1.3.0
# Only needed when deliberately serving the frontend from a separate origin:
# CLIENT_URL=https://your-game.example
# Single-process admission limits; raise only after measuring host capacity.
MAX_ROOMS=8
MAX_CONNECTIONS=96
# Per-network abuse guardrails; keep below MAX_CONNECTIONS when public.
MAX_CONNECTIONS_PER_IP=32
JOIN_ATTEMPTS_PER_IP=120
# Set only when a trusted reverse proxy overwrites X-Forwarded-For.
# TRUST_PROXY=true
# First measured public step. Promote to 64 only with fresh host and device evidence.
MAX_ROOM_PLAYERS=32
# Keep this file on persistent storage in production.
# RANKINGS_FILE=/app/server/data/rankings.json

# ---- Community automation (see docs/AUTOMATION.md, docs/SRE.md) ----
# Shared bearer token for inbound Fider webhooks. Fider cannot HMAC-sign, so
# this is the credential it actually uses (Authorization: Bearer <token>, or
# x-fider-token). Set at least one of this or FIDER_WEBHOOK_SECRET.
# FIDER_WEBHOOK_TOKEN=
# Optional HMAC secret for senders that can sign the raw body (sha256).
# FIDER_WEBHOOK_SECRET=
# Shared secret the Hermes agent uses for /api/community/queue and /action.
# COMMUNITY_ACTION_TOKEN=
# Metrics are exposed unauthenticated at GET /metrics (aggregate, non-PII).
